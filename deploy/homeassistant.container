[Unit]
Description=Home Assistant (Alexa bridge for Nexus)
After=network-online.target

[Container]
ContainerName=homeassistant
Image=ghcr.io/home-assistant/home-assistant:stable
Network=nexus.network
# No host port: reached over HTTPS via Caddy on :8443.
Volume=homeassistant-config:/config
Environment=TZ=Asia/Kolkata

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
