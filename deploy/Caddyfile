{
	# Browsers send no SNI for IP addresses; serve the LAN-IP cert by default.
	default_sni 192.168.31.128
}

192.168.31.128, epimetheus, epimetheus.lan {
	# shortcut: Caddy internal CA (self-signed), clients see a cert warning until they trust it; switch to a real domain/Tailscale cert if that bothers.
	tls internal

	# Studio cameras: WebRTC signalling (WHEP) to MediaMTX on crashmetheus, only for logged-in Nexus sessions.
	# The video itself flows directly between MediaMTX and the browser.
	@whep {
		path_regexp ^/studio/[a-z0-9_-]+/whep$
		method POST
	}
	handle @whep {
		uri strip_prefix /studio
		forward_auth nexus:3000 {
			uri /api/studio/auth
		}
		reverse_proxy 192.168.31.247:8889 {
			header_down -WWW-Authenticate # never pop a browser login box for MediaMTX
		}
	}
	handle /studio/* {
		respond 404
	}

	handle {
		encode gzip
		reverse_proxy nexus:3000
	}
}

# Home Assistant admin UI (Alexa Media Player login happens here, so HTTPS only).
192.168.31.128:8443, epimetheus:8443, epimetheus.lan:8443 {
	tls internal
	reverse_proxy homeassistant:8123
}
