[Unit]
After=systemd-tmpfiles-setup.service
Description=Snapshot container status for Nexus (read-only feed, no socket exposure)

[Service]
Type=oneshot
# Raw podman output includes labels/commands: keep it root-only.
UMask=0077
ExecStart=/bin/sh -c 'podman ps -a --format json > /run/nexus/containers.json.tmp && mv /run/nexus/containers.json.tmp /run/nexus/containers.json'
