[Unit]
Description=Nexus core (API + UI)
After=network-online.target nexus-snapshot.service
Wants=nexus-snapshot.service

[Container]
ContainerName=nexus
Image=localhost/nexus:latest
Pull=never
Network=nexus.network
Volume=nexus-data:/data
# Directory (not file) mount so atomic replaces by nexus-snapshot are visible.
Volume=/run/nexus:/run/nexus:ro
# Mac companion ssh key + pinned host key (root-only on the host).
Volume=/etc/nexus/mac:/etc/nexus/mac:ro
EnvironmentFile=/etc/nexus/nexus.env

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
