[Unit]
Description=Nexus core (API + UI)
After=network-online.target

[Container]
ContainerName=nexus
Image=localhost/nexus:latest
Pull=never
Network=nexus.network
Volume=nexus-data:/data
EnvironmentFile=/etc/nexus/nexus.env
HealthCmd=node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
HealthInterval=30s
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
